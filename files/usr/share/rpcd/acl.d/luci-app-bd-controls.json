{
	"luci-app-bd-controls": {
		"description": "Grant access to the bd-controls LuCI application",

		"read": {
			"file": {
				"/usr/bin/bd-controls status": [ "exec" ],
				"/usr/bin/bd-controls usage": [ "exec" ]
			}
		},

		"write": {
			"file": {
				"/usr/bin/bd-controls block *": [ "exec" ],
				"/usr/bin/bd-controls limit *": [ "exec" ],
				"/usr/bin/bd-controls reset *": [ "exec" ],
				"/usr/bin/bd-controls sched *": [ "exec" ]
			}
		}
	}
}